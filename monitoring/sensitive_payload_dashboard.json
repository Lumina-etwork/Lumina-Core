{
  "title": "Sensitive Payload Field E2EE",
  "panels": [
    {
      "title": "P99 crypto latency",
      "query": "histogram_quantile(0.99, sum(rate(sensitive_payload_crypto_duration_seconds_bucket[5m])) by (le, service, operation))"
    },
    {
      "title": "Authentication failures",
      "query": "sum(rate(sensitive_payload_crypto_auth_failures_total[5m])) by (service, payload_type, field_path)"
    },
    {
      "title": "Protected fields processed",
      "query": "sum(rate(sensitive_payload_fields_total[5m])) by (service, payload_type, operation)"
    }
  ]
}
