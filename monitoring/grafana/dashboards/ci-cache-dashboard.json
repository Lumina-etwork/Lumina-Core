{
  "title": "CI Docker Layer Cache",
  "description": "Monitoreo del cache de layers Docker en el pipeline CI de Lumina-Core",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Cache hit rate (1h)",
      "description": "Porcentaje de layers servidas desde cache vs compiladas desde cero",
      "targets": [
        {
          "expr": "rate(ci_docker_cache_hits_total[1h]) / (rate(ci_docker_cache_hits_total[1h]) + rate(ci_docker_cache_misses_total[1h]))",
          "legendFormat": "{{ scope }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0    },
              { "color": "yellow", "value": 0.7  },
              { "color": "green",  "value": 0.85 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Antiguedad del cache base-toolchain",
      "description": "Tiempo desde el ultimo push exitoso al scope lumina-base-toolchain",
      "targets": [
        {
          "expr": "time() - ci_docker_cache_last_push_timestamp_seconds{scope=\"lumina-base-toolchain\"}",
          "legendFormat": "edad"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0     },
              { "color": "yellow", "value": 43200  },
              { "color": "red",    "value": 86400  }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "deps-cache build P99 (ultima 1h)",
      "description": "Percentil 99 de duracion de la stage deps-cache — objetivo < 600s",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(ci_docker_build_duration_seconds_bucket{stage=\"deps-cache\"}[1h]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0   },
              { "color": "yellow", "value": 300 },
              { "color": "red",    "value": 600 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hits vs misses por scope (5m rate)",
      "targets": [
        {
          "expr": "rate(ci_docker_cache_hits_total[5m])",
          "legendFormat": "hits: {{ scope }}"
        },
        {
          "expr": "rate(ci_docker_cache_misses_total[5m])",
          "legendFormat": "misses: {{ scope }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duracion de build por stage",
      "targets": [
        {
          "expr": "ci_docker_build_duration_seconds{stage=\"base-toolchain\"}",
          "legendFormat": "base-toolchain"
        },
        {
          "expr": "ci_docker_build_duration_seconds{stage=\"deps-cache\"}",
          "legendFormat": "deps-cache"
        },
        {
          "expr": "ci_docker_build_duration_seconds{stage=\"build\"}",
          "legendFormat": "build"
        },
        {
          "expr": "ci_docker_build_duration_seconds{stage=\"final\"}",
          "legendFormat": "final"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ultimo refresh por scope (timestamp)",
      "description": "Identifica scopes que no se estan actualizando — alerta si > 24h",
      "targets": [
        {
          "expr": "ci_docker_cache_last_push_timestamp_seconds",
          "legendFormat": "{{ scope }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "dateTimeAsIso" }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 14 }
    }
  ]
}
