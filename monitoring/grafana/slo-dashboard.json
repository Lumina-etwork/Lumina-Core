{
  "title": "Lumina Core SLO Overview",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Error budget burn rate",
      "type": "timeseries",
      "targets": [
        { "expr": "lumina:slo_error_ratio:5m / (1 - 0.9999)", "legendFormat": "{{service}} 5m" },
        { "expr": "lumina:slo_error_ratio:1h / (1 - 0.9999)", "legendFormat": "{{service}} 1h" }
      ]
    },
    {
      "title": "Critical path P99 latency",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(lumina_request_duration_seconds_bucket[5m])) by (le, service, environment)) * 1000", "legendFormat": "{{service}} p99 ms" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 100 }] } } }
    }
  ]
}
