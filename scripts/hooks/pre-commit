#!/usr/bin/env bash
# scripts/hooks/pre-commit
# Lumina-Core pre-commit gate — mirrors CI lint + security checks at commit time.
# Runs fast checks in parallel; expensive checks only on relevant file changes.
set -euo pipefail

HOOK_START=$(date +%s%3N)
REPO_ROOT=$(git rev-parse --show-toplevel)
HOOKS_DIR="$REPO_ROOT/scripts/hooks"
PASS=0
FAIL=0

# ── Colour helpers ────────────────────────────────────────────────────────────
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'
pass()   { printf "${GREEN}  ✓ %s${NC}\n" "$1" >&2; PASS=$((PASS+1)); }
fail()   { printf "${RED}  ✗ %s${NC}\n"  "$1" >&2; FAIL=$((FAIL+1)); }
header() { printf "\n${CYAN}── %s ──${NC}\n" "$1" >&2; }
skip()   { printf "${YELLOW}  ~ %s (skipped)${NC}\n" "$1" >&2; }

# ── Skip conditions ───────────────────────────────────────────────────────────
if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then
  printf "${YELLOW}[pre-commit] SKIP_HOOKS=1 — all hooks bypassed${NC}\n" >&2
  exit 0
fi

# ── Staged file detection ─────────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
HAS_RUST=$(echo "$STAGED" | grep -qE '\.(rs|toml)$' && echo 1 || echo 0)
HAS_CONTRACTS=$(echo "$STAGED" | grep -qE '^contracts/' && echo 1 || echo 0)
HAS_SCRIPTS=$(echo "$STAGED" | grep -qE '\.(sh|bash)$' && echo 1 || echo 0)

# ── Parallel execution harness ────────────────────────────────────────────────
pids=()
labels=()

run_parallel() {
  local label="$1"; shift
  "$@" &>"/tmp/lumina-hook-$$-${#pids[@]}.log" &
  pids+=($!)
  labels+=("$label")
}

collect_parallel() {
  local idx=0
  for pid in "${pids[@]}"; do
    local log="/tmp/lumina-hook-$$-${idx}.log"
    if wait "$pid"; then
      pass "${labels[$idx]}"
    else
      fail "${labels[$idx]}"
      cat "$log" >&2
    fi
    rm -f "$log"
    idx=$((idx+1))
  done
  pids=()
  labels=()
}

# ── CHECK GROUP 1: siempre activo, rápido (<3s) ───────────────────────────────
header "Fast checks (always-on)"
run_parallel "secret-scan"  "$HOOKS_DIR/check-secrets.sh"
run_parallel "file-guards"  "$HOOKS_DIR/check-file-guards.sh"
collect_parallel

# ── CHECK GROUP 2: Rust (solo si hay .rs o .toml staged) ─────────────────────
if [[ "$HAS_RUST" == "1" ]]; then
  header "Rust quality (staged .rs/.toml detected)"
  run_parallel "rustfmt" "$HOOKS_DIR/check-rustfmt.sh"
  run_parallel "clippy"  "$HOOKS_DIR/check-clippy.sh"
  collect_parallel
else
  skip "rustfmt / clippy (no Rust files staged)"
fi

# ── CHECK GROUP 3: Contratos (solo si hay cambios en contracts/) ──────────────
if [[ "$HAS_CONTRACTS" == "1" ]]; then
  header "Smart contract checks (contracts/ staged)"
  if "$HOOKS_DIR/check-wasm-build.sh"; then
    pass "wasm-build"
  else
    fail "wasm-build"
  fi
else
  skip "wasm-build (no contracts/ changes staged)"
fi

# ── CHECK GROUP 4: Shell (solo si hay .sh staged) ────────────────────────────
if [[ "$HAS_SCRIPTS" == "1" ]]; then
  header "Shell checks"
  run_parallel "shellcheck" "$HOOKS_DIR/check-shellcheck.sh"
  collect_parallel
else
  skip "shellcheck (no shell files staged)"
fi

# ── SUMMARY & METRICS ─────────────────────────────────────────────────────────
HOOK_END=$(date +%s%3N)
DURATION_MS=$((HOOK_END - HOOK_START))

printf "\n[pre-commit] Result: ${GREEN}%d passed${NC}  ${RED}%d failed${NC}  (%dms)\n" \
  "$PASS" "$FAIL" "$DURATION_MS" >&2

# Emitir métricas al pushgateway (best-effort, nunca bloquea el commit)
"$HOOKS_DIR/emit-hook-metrics.sh" "$PASS" "$FAIL" "$DURATION_MS" &>/dev/null || true

[[ "$FAIL" -eq 0 ]] && exit 0 || exit 1
