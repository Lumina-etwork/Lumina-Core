#!/usr/bin/env bash
# scripts/hooks/pre-push
# Runs cargo-deny (license + ban + advisories) before push to remote.
# Deliberately pre-PUSH (not pre-commit) because cargo-deny can take 5-10s.
set -euo pipefail

if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then exit 0; fi

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if ! command -v cargo-deny &>/dev/null; then
  printf '[pre-push] cargo-deny not found — install: cargo install cargo-deny --locked\n' >&2
  printf '[pre-push] WARNING: dependency policy check skipped\n' >&2
  exit 0
fi

printf '[pre-push] Running cargo deny check...\n' >&2
cargo deny check advisories licenses bans 2>&1
