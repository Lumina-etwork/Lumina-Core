#!/usr/bin/env bash
# scripts/hooks/commit-msg
# Enforces Conventional Commits format: type(scope): description
set -euo pipefail

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Permitir commits generados por git (merge, revert, fixup, squash)
if echo "$MSG" | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|security|contract)(\([a-z0-9_-]+\))?: .{1,100}'
if ! echo "$MSG" | grep -qE "$PATTERN"; then
  cat >&2 <<'ERR'
[commit-msg] El mensaje de commit debe seguir Conventional Commits:

  type(scope): descripción corta (≤ 100 chars)

  Tipos permitidos:
    feat, fix, docs, style, refactor, perf, test,
    build, ci, chore, security, contract

  Ejemplos:
    feat(staking): add auto-compound mechanism
    fix(consensus): resolve leader election deadlock
    security(contracts): patch reentrancy in deposit adapter
    ci(hooks): add pre-commit wasm build gate
ERR
  exit 1
fi
