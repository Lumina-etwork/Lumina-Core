#!/bin/bash
set -e

echo "Running pre-commit hook..."

# Run cargo fmt
echo "Running cargo fmt..."
cargo fmt --check
if [ $? -ne 0 ]; then
    echo "Formatting issues found. Please run 'cargo fmt' to fix them."
    exit 1
fi

# Run cargo clippy
echo "Running cargo clippy..."
cargo clippy --all-targets --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo "Clippy warnings/errors found. Please fix them."
    exit 1
fi

echo "Pre-commit checks passed!"
